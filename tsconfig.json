{
  "include": ["src", "test"],
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowJs": true,

    "strict": true,
    "noUnusedLocals": true,

    "target": "ES2020",
    "module": "NodeNext",
    "sourceMap": true,
    "declaration": true,

    "noEmit": true
  }
}
